# Copiar como backend/.env. Contraseñas iguales a dev/dev.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
INSTANCE_ID=api-local
LOG_LEVEL=debug
TRUST_PROXY=loopback

DATABASE_URL=postgresql://ecommerce_app:dev-app@127.0.0.1:5432/ecommerce
DB_SSL_MODE=disable
DB_POOL_MAX=10
REDIS_URL=redis://ecommerce_app:dev-redis-app@127.0.0.1:6379/0

JWT_SECRET=dev-jwt-secret-solo-para-desarrollo-local
JWT_EXPIRES_IN=7200
# false: en desarrollo se usa HTTP.
COOKIE_SECURE=false

# Solo para Prisma CLI (migraciones).
MIGRATE_DATABASE_URL=postgresql://ecommerce_owner:dev-owner@127.0.0.1:5432/ecommerce

# Solo para pnpm create-admin.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@sistema-e.local
ADMIN_PASSWORD=admin-dev-123
