{
  "name": "@sistema-e/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate && tsc -b",
    "typecheck": "prisma generate && tsc -b ../packages/contracts && tsc --noEmit && tsc -p scripts",
    "start": "node dist/server.js",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:verify": "tsx --env-file-if-exists=.env scripts/verify-db.ts",
    "create-admin": "tsx --env-file-if-exists=.env scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sistema-e/contracts": "workspace:*",
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-express": "4.1.8",
    "pg": "8.23.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  }
}
